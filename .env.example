# Copy to .env and export these in your shell. Never commit real values.

# TypeSafe System One key. Used by `gfw judge` and by the proxy for destinations
# the static policy sends to review. https://docs.typesafe.ai
JEV_API_KEY=

# Abliteration project key. Used only when GFW_ANALYST=1, and only to explain
# a review or block decision. https://docs.abliteration.ai
ABLITERATION_API_KEY=

# Set to 1 to ask Abliteration for a short explanation. Default is off.
GFW_ANALYST=

# Skip the explanation when remaining prepaid credits are below this many USD.
GFW_ANALYST_MIN_BALANCE=5

# Optional path for the append-only decision log.
GFW_AUDIT=audit/decisions.jsonl
